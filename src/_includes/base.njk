<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · {{ site.title }}</title>
  <meta name="description" content="{{ (content | excerpt) if useExcerptDescription else (description or site.description) }}">
  <link rel="icon" href="/favicon.ico">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{ fonts.href }}">
  <link rel="stylesheet" href="/css/site.css">
  <script>
    (function () {
      try {
        var combo = localStorage.getItem('fontCombo');
        if (combo && combo !== 'redhat') document.documentElement.setAttribute('data-font-combo', combo);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <div class="nav-bar">
    <div class="nav-slot">
      {% if navBack %}
      <a class="corner-icon" href="{{ navBack }}" aria-label="Back">
        <svg viewBox="0 0 24 24"><path d="M15 5 L7 12 L15 19"/></svg>
      </a>
      {% endif %}
    </div>
    <div class="nav-slot">
      {% if navBio %}
      <a class="corner-icon" href="/bio/" aria-label="Bio">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
      </a>
      {% endif %}
    </div>
  </div>
  <main>
    {{ content | safe }}
  </main>
  <div class="font-switcher" role="group" aria-label="Font combo switcher">
    {% for combo in fonts.combos %}<button type="button" data-combo="{{ combo.id }}">{{ combo.label }}</button>
    {% endfor %}
  </div>
  <script>
    (function () {
      var root = document.documentElement;
      var buttons = document.querySelectorAll('.font-switcher button');
      function setActive(combo) {
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', b.dataset.combo === combo ? 'true' : 'false');
        });
      }
      setActive(root.getAttribute('data-font-combo') || 'redhat');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var combo = btn.dataset.combo;
          if (combo === 'redhat') {
            root.removeAttribute('data-font-combo');
          } else {
            root.setAttribute('data-font-combo', combo);
          }
          try { localStorage.setItem('fontCombo', combo); } catch (e) {}
          setActive(combo);
        });
      });
    })();
  </script>
</body>
</html>
