---
layout: base.njk
navBack: /
navBio: true
---
<article class="page">
  {% if profileImage %}
  <img class="page-portrait" src="{{ profileImage }}" alt="{{ profileImageAlt or title }}" width="152" height="152">
  {% endif %}
  <h1>{{ title }}</h1>
  {{ content | safe }}
  {% if showSocialLinks %}
  <p class="bio-links">
    {% for s in site.social %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.platform }}</a>
    {% endfor %}<a href="/feed.xml">RSS</a>
  </p>
  {% endif %}
</article>
